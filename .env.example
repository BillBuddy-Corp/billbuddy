# Copy this file to .env and fill in real values. .env is gitignored and
# never committed. See docker/docker-compose.yml for how these are wired
# into the backend and db containers.

# --- Spring ---
SPRING_PROFILES_ACTIVE=default
SERVER_PORT=8080

# --- Database (also used by the postgres container itself) ---
POSTGRES_DB=billbuddy
POSTGRES_USER=billbuddy_user
POSTGRES_PASSWORD=your-db-password-here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Same database, as the Spring datasource connection string -- use the
# docker-compose service name (billbuddy-db) as the host when running via
# docker compose, or localhost if you're running Postgres yourself.
SPRING_DATASOURCE_URL=jdbc:postgresql://billbuddy-db:5432/billbuddy
SPRING_DATASOURCE_USERNAME=billbuddy_user
SPRING_DATASOURCE_PASSWORD=your-db-password-here

SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# --- JWT ---
# A long, random secret -- e.g. `openssl rand -base64 64`
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# --- Mail (Gmail SMTP -- MAIL_PASSWORD is an App Password, not your account password) ---
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-gmail-app-password-here

# --- AI providers ---
# Claude powers the Bill Scanner (see apps/backend/docs/bill-scanner.md).
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_WORKSPACE_ID=

# Unused by default; only needed if you wire up a Gemini-backed feature.
GEMINI_API_KEY=unused

# --- Google Sign-In ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id-here
